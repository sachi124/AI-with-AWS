    "# We create 1D ndarray that contains only integers\n",
    "import numpy as np\n",
    "\n",
    "X = np.array([1, 2, 3, 4, 5])\n",
    "\n",
    "# We will print information about X\n",
    "print(f\"X =\", X)\n",
    "print(\"X has dimensions:\", X.shape)\n",
    "print(\"X is an object of type:\", type(X))\n",
    "print(\"The element in x are type:\", X.dtype)"
   ]
  }
